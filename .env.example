# Copy this file to `.env` and fill in the values below.
#   cp .env.example .env

# REQUIRED on first run — used to seed the initial admin account.
# After the admin user is created in the database, these values are no longer needed.
CCM_ADMIN_EMAIL=admin@example.com
CCM_ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional — defaults shown.
# CCM_CONFIG=config.yaml
# CCM_DATABASE_URL=sqlite:///./data.db
# CCM_LOG_LEVEL=INFO
